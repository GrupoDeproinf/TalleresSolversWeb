rules_version = '2';

// ============================================================================
// Solvers — Reglas de Firestore
//
// Quién usa Firestore directamente:
//  - El panel web, y desde ahora SOLO el personal de Solvers (Admins,
//    Certificadores y Soporte). Los talleres administran su negocio en la app.
//  - La app móvil NO lee Firestore: todo pasa por la API (firebase-admin), que
//    no evalúa estas reglas. Cambiarlas no afecta a la app.
//
// Antes cualquier sesión de Firebase Auth (incluida la de cualquier conductor
// o taller de la app) podía leer y escribir toda la base. Ahora:
//  - Cada persona puede leer su propio documento de Usuarios o Admins (el
//    panel lo necesita al iniciar sesión para saber su rol).
//  - Todo lo demás, solo el personal de Solvers.
//
// El personal se reconoce por documentos que solo el personal o la API
// pueden escribir: Admins/{uid}, Usuarios/{uid} con typeUser Certificador o
// Soporte (la API siempre registra con typeUser Cliente o Taller), o
// Personal/{uid}. Personal/ cubre las cuentas antiguas cuyo documento no usa
// el uid de Firebase Auth como id (lo llena scripts/registrar-personal.js).
//
// Pruebas: reglas-pruebas/ (emulador de Firestore y Storage).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function activo(datos) {
      return datos.get('status', '') != 'Eliminado';
    }

    function esAdmin() {
      let ruta = /databases/$(database)/documents/Admins/$(request.auth.uid);
      return exists(ruta) && activo(get(ruta).data);
    }

    function esCertificadorOSoporte() {
      let ruta = /databases/$(database)/documents/Usuarios/$(request.auth.uid);
      return exists(ruta)
        && get(ruta).data.get('typeUser', '') in ['Certificador', 'Soporte']
        && activo(get(ruta).data);
    }

    function enListaDePersonal() {
      let ruta = /databases/$(database)/documents/Personal/$(request.auth.uid);
      return exists(ruta) && get(ruta).data.get('activo', false) == true;
    }

    function esPersonal() {
      return conSesion() && (esAdmin() || esCertificadorOSoporte() || enListaDePersonal());
    }

    // Inicio de sesión del panel: leer el propio perfil para saber el rol.
    match /Usuarios/{id} {
      allow get: if conSesion() && request.auth.uid == id;
    }
    match /Admins/{id} {
      allow get: if conSesion() && request.auth.uid == id;
    }
    match /Personal/{id} {
      allow get: if conSesion() && request.auth.uid == id;
    }

    // Todo lo demás: solo el personal de Solvers.
    match /{document=**} {
      allow read, write: if esPersonal();
    }
  }
}
