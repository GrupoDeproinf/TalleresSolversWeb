rules_version = '2';

// ============================================================================
// Solvers — Storage Security Rules
// Fase 0 (Contención): cierra la fuga de datos sensibles y toda ESCRITURA anónima.
//
// Contexto verificado en auditoría:
//  - Las imágenes se sirven mediante URLs de descarga con token
//    (?alt=media&token=...), que NO dependen de estas reglas => seguir con
//    lectura pública en las carpetas de imágenes NO rompe la app ni el panel.
//  - La app móvil no usa el SDK de Storage; sus subidas pasan por el backend
//    (admin), que ignora estas reglas. El panel sube autenticado.
//  => Bloquear ESCRITURA a solo-autenticados es seguro.
//  - Las carpetas 'documents/' y 'paymentcommitment/' contienen datos sensibles
//    (documentos de identidad, comprobantes de pago). El panel los muestra vía
//    URL con token (bypass de reglas), por lo que restringir su lectura a
//    autenticados cierra la fuga SIN romper la vista de administración.
//
// No hay catch-all público: cualquier ruta no listada queda DENEGADA por
// defecto. Las carpetas listadas cubren el bucket actual completo.
// La restricción por propietario/rol se afinará en la iteración role-based.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // --- Datos sensibles: solo sesión autenticada (lectura y escritura) ---
    match /documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /paymentcommitment/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // --- Imágenes y activos mostrados en la app/panel ---
    // Lectura pública TEMPORAL (se sirven por URL con token igualmente);
    // escritura solo autenticada.
    match /profileImages/{allPaths=**}    { allow read: if true; allow write: if request.auth != null; }
    match /businessImages/{allPaths=**}   { allow read: if true; allow write: if request.auth != null; }
    match /categoriesImages/{allPaths=**} { allow read: if true; allow write: if request.auth != null; }
    match /service_images/{allPaths=**}   { allow read: if true; allow write: if request.auth != null; }
    match /vehicles/{allPaths=**}         { allow read: if true; allow write: if request.auth != null; }
    match /usuarios/{allPaths=**}         { allow read: if true; allow write: if request.auth != null; }
    match /Solicitudes/{allPaths=**}      { allow read: if true; allow write: if request.auth != null; }
    match /data/{allPaths=**}             { allow read: if true; allow write: if request.auth != null; }

  }
}
