rules_version = '2';

// ============================================================================
// Solvers — Reglas de Storage
//
//  - La app móvil no usa el SDK de Storage: sus subidas pasan por la API
//    (firebase-admin), que ignora estas reglas.
//  - El panel sube y consulta archivos, y desde ahora solo lo usa el personal
//    de Solvers (ver firestore.rules).
//  - Las imágenes se muestran con URLs públicas o de descarga con token, que
//    no dependen de estas reglas.
//
// Antes cualquier sesión (cualquier conductor o taller de la app) podía leer
// documentos de identidad y comprobantes de pago, y subir o reemplazar
// cualquier archivo. Ahora:
//  - Documentos y comprobantes: solo el personal lee y escribe.
//  - Imágenes: lectura pública como hasta ahora; solo el personal escribe.
//  - Cualquier carpeta no listada queda cerrada.
//
// El personal se reconoce igual que en firestore.rules (consulta a Firestore
// desde Storage; al publicar, Firebase pide permitir esa consulta una vez).
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function activo(datos) {
      return datos.get('status', '') != 'Eliminado';
    }

    function esAdmin() {
      let ruta = /databases/(default)/documents/Admins/$(request.auth.uid);
      return firestore.exists(ruta) && activo(firestore.get(ruta).data);
    }

    function esCertificadorOSoporte() {
      let ruta = /databases/(default)/documents/Usuarios/$(request.auth.uid);
      return firestore.exists(ruta)
        && firestore.get(ruta).data.get('typeUser', '') in ['Certificador', 'Soporte']
        && activo(firestore.get(ruta).data);
    }

    function enListaDePersonal() {
      let ruta = /databases/(default)/documents/Personal/$(request.auth.uid);
      return firestore.exists(ruta) && firestore.get(ruta).data.get('activo', false) == true;
    }

    function esPersonal() {
      return request.auth != null
        && (esAdmin() || esCertificadorOSoporte() || enListaDePersonal());
    }

    // --- Datos sensibles: solo el personal ---
    match /documents/{allPaths=**} {
      allow read, write: if esPersonal();
    }
    match /paymentcommitment/{allPaths=**} {
      allow read, write: if esPersonal();
    }

    // --- Imágenes que se muestran en la app y el panel ---
    match /profileImages/{allPaths=**}    { allow read: if true; allow write: if esPersonal(); }
    match /businessImages/{allPaths=**}   { allow read: if true; allow write: if esPersonal(); }
    match /categoriesImages/{allPaths=**} { allow read: if true; allow write: if esPersonal(); }
    match /service_images/{allPaths=**}   { allow read: if true; allow write: if esPersonal(); }
    match /promotion_images/{allPaths=**} { allow read: if true; allow write: if esPersonal(); }
    match /vehicles/{allPaths=**}         { allow read: if true; allow write: if esPersonal(); }
    match /usuarios/{allPaths=**}         { allow read: if true; allow write: if esPersonal(); }
    match /Solicitudes/{allPaths=**}      { allow read: if true; allow write: if esPersonal(); }
    match /data/{allPaths=**}             { allow read: if true; allow write: if esPersonal(); }

  }
}
